from pathlib import Path
import sys

name = sys.argv[1]

def get_opt(*args):
    for arg in args:
        if 0 <= arg < len(sys.argv):
            opt = sys.argv[arg]
            return opt

directory = Path(name)
directory.mkdir()

include_math = ""
ldflags = ""

opt = get_opt(2)
if opt == "-lm":
    include_math = "#include <math.h>"
    ldflags = "LDFLAGS = -lm"

(directory/ f"{name}.c").write_text(f"""\
#include <stdio.h>
#include <stdlib.h>
{include_math}
int main(void) {{
\tprintf("Hello, World!\\n");
\treturn 0;
}}
""", encoding="utf-8")
    
(directory/ "makefile").write_text(f"""\
CC = gcc
CFLAGS = -Wall -Wextra -O2
{ldflags}
TARGET = {name}
SRCS = {name}.c
OBJS = $(SRCS:.c=.o)
all: $(TARGET)
$(TARGET): $(OBJS)
\t$(CC) $(CFLAGS) -o $@ $^
run: $(TARGET)
\t./$(TARGET)
clean:
\trm -f $(TARGET) $(OBJS)
""", encoding="utf-8")