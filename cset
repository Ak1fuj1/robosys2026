from pathlib import Path
import sys

name = sys.argv[1]

directory = Path(name)
directory.mkdir()

include_math = ""
ldflags = []

opts = sys.argv[2:]
headers = {}

path = Path(__file__).resolve().parent / "cset_option.txt"

with open(path, "r", encoding="utf-8") as f:
    for line in f:
        parts = line.split()
        
        if len(parts) < 2:
            continue
    
        option = parts[0]
        header_name = parts[1:]
        
        headers[option] = header_name

includes = []

for opt in opts:
    for header in headers.get(opt, []):
        include = f"#include <{header}>"
        
        if include not in includes:
            includes.append(include)
            
include_text = "\n".join(includes)
ldflags = " ".join(opts)

(directory/ f"{name}.c").write_text(f"""\
#include <stdio.h>
#include <stdlib.h>
{include_text}
int main(void) {{
\tprintf("Hello, World!\\n");
\treturn 0;
}}
""", encoding="utf-8")
    
(directory/ "makefile").write_text(f"""\
CC = gcc
CFLAGS = -Wall -Wextra -O2
LDFLAGS = {ldflags}
TARGET = {name}
SRCS = {name}.c
OBJS = $(SRCS:.c=.o)
all: $(TARGET)
$(TARGET): $(OBJS)
\t$(CC) $(CFLAGS) -o $@ $^ @(LDFLAGS)
run: $(TARGET)
\t./$(TARGET)
clean:
\trm -f $(TARGET) $(OBJS)
""", encoding="utf-8")