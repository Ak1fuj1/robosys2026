from pathlib import Path
import sys

name = sys.argv[1]

directory = Path(name)
directory.mkdir()

include_math = ""
ldflags = []

opts = sys.argv[2:]

if opts == "-lm":
    include_math = "#include <math.h>"
    mathflag = " -lm"

for opt in opts:
    if opt == "-lm":
        include_math = "#include <math.h>"
        ldflags.append(opt)

# if you add new module
#    elif opt == "-l":
#       include_ = "#include <.h>"
#       ldflags.append(opt)
        
flags = " ".join(ldflags)

(directory/ f"{name}.c").write_text(f"""\
#include <stdio.h>
#include <stdlib.h>
{include_math}
int main(void) {{
\tprintf("Hello, World!\\n");
\treturn 0;
}}
""", encoding="utf-8")
    
(directory/ "makefile").write_text(f"""\
CC = gcc
CFLAGS = -Wall -Wextra -O2
LDFLAGS = {flags}
TARGET = {name}
SRCS = {name}.c
OBJS = $(SRCS:.c=.o)
all: $(TARGET)
$(TARGET): $(OBJS)
\t$(CC) $(CFLAGS) -o $@ $^
run: $(TARGET)
\t./$(TARGET)
clean:
\trm -f $(TARGET) $(OBJS)
""", encoding="utf-8")