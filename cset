from pathlib import Path
import sys

name = sys.argv[1]

directory = Path(name)
directory.mkdir()
    
(directory/ f"{name}.c").write_text("""\
#include <stdio.h>
#include <stdlib.h>
int main(void) {
    printf("Hello, World!\\n");
    return 0;
}
""", encoding="utf-8")
    
(directory/ "makefile").write_text(f"""\
CC = gcc
CFLAGS = -Wall -Wextra -O2
TARGET = {name}
SRCS = {name}.c
OBJS = $(SRCS:.c=.o)
all: $(TARGET)
$(TARGET): $(OBJS)
\t$(CC) $(CFLAGS) -o $@ $^
run: $(TARGET)
\t./$(TARGET)
clean:
\trm -f $(TARGET) $(OBJS)
""", encoding="utf-8")